{
  "manifest_version": 3,
  "name": "JobPilot Autofill",
  "version": "1.0.0",
  "description": "Fills job applications with your JobPilot profile, resume and approved answers. You review and press Submit.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*", "http://localhost/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "JobPilot Autofill" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
