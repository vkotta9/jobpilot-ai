# Copy to .env (git-ignored) and fill in. Every value is optional for local use.

# --- Database ------------------------------------------------------------
# Default: SQLite file at ./data/jobpilot.db
# DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot

# --- AI (optional) -------------------------------------------------------
# Without a key JobPilot uses rule-based tailoring (still fact-safe).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# JOBPILOT_LLM_TIMEOUT=45

# --- Storage -------------------------------------------------------------
# JOBPILOT_DATA_DIR=./data
# JOBPILOT_MAX_UPLOAD_MB=5

# --- Automation ----------------------------------------------------------
# JOBPILOT_SCHEDULER=1            # 0 disables the background search loop
# JOBPILOT_SCHEDULER_TICK=60      # seconds between scheduler checks

# --- Security ------------------------------------------------------------
# JOBPILOT_SESSION_DAYS=14
# JOBPILOT_ALLOW_REGISTRATION=1   # set 0 after creating your account on a public server

# --- Demo data -----------------------------------------------------------
# JOBPILOT_ALLOW_MOCK_SOURCES=1   # simulated, clearly-labelled demo listings; set 0 in production

# --- Job source HTTP -----------------------------------------------------
# JOBPILOT_HTTP_TIMEOUT=20
# JOBPILOT_USER_AGENT=JobPilotAI/0.1 (personal job-search assistant; you@example.com)
